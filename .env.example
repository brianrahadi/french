# Optional: sign-in with Google and sync across devices (see README → "Sign-in and sync").
# Copy this file to .env.local and fill in the values from your Supabase project:
# Dashboard → Project Settings → API Keys (Project URL and the publishable key).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Where Google sign-in returns to on the live site (local dev returns to localhost).
VITE_SITE_URL=https://french.brianrahadi.com/
